# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to GitHub - it's in .gitignore for security

# Supabase (Database & Auth)
# Get these from https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI Assistant (Claude API)
# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (Payment Processing)
# Get these from https://stripe.com/dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Email Service (SendGrid or Resend)
SENDGRID_API_KEY=your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G_...

# App Settings
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NODE_ENV=development
